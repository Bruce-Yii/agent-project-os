# Example environment file. Copy to .env and replace every value.
# Never commit .env or real secrets. Empty values are intentional placeholders.

# Database (local development only; not a product decision)
DATABASE_URL=

# Provider and integration credentials (placeholders only; leave empty until configured)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GITHUB_TOKEN=

# Server
PORT=3000
LOG_LEVEL=info
NODE_ENV=development